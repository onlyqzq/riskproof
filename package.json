{
  "name": "dsh-riskproof",
  "version": "0.2.0",
  "description": "Provenance-aware execution security for DeepSeek Harness. Track sensitive data across tool calls and stop risky side effects before execution.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-agent",
    "agent-security",
    "provenance",
    "information-flow-control",
    "tool-security",
    "taint-tracking",
    "execution-security",
    "policy-engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyqzq/dsh-riskproof.git"
  },
  "bugs": {
    "url": "https://github.com/onlyqzq/dsh-riskproof/issues"
  },
  "homepage": "https://github.com/onlyqzq/dsh-riskproof#readme",
  "author": "RiskProof Contributors",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "npm run typecheck && npm run typecheck:test",
    "check:marketplace": "node scripts/check-marketplace-readiness.mjs",
    "verify": "npm run lint && npm run check:marketplace && npm run build && npm test",
    "pack:smoke": "npm run build && npm pack --dry-run",
    "demo": "npm run build && node demo/run-attack-chain.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.11"
  }
}
